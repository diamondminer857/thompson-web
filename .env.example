# Cloudflare Web Analytics token. Copy this file to .env and fill it in, and set
# the same variable in the Cloudflare dashboard so production builds get it too.
# Dashboard → Analytics & Logs → Web Analytics → add thompsondj.com → the token
# is the `token` value in the snippet it shows you.
# Without it the beacon is simply not rendered.
PUBLIC_CF_BEACON_TOKEN=
