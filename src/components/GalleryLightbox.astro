---
import type { ImageMetadata } from 'astro';
import MediaFrame from './MediaFrame.astro';

interface Item {
  src: ImageMetadata | null;
  alt: string;
  ratio: `${number} / ${number}`;
  path: string;
  tone?: 'cyan' | 'magenta' | 'violet';
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<!--
  Every slide is prerendered at build time (same MediaFrame/Placeholder
  branch as the grid tile that opens it) rather than built client-side, so
  there's no risk of the lightbox showing a broken/empty state — it's just
  visibility toggled on markup that was always there. Open/close/keyboard-nav
  are plain DOM in this file's own <script>, functional with no animation
  library at all; the anime.js flourish (FLIP-style open, crossfade on
  next/prev) layers on top of that and is skipped outright under
  `prefers-reduced-motion`, same policy as `motion.ts`.
-->
<div class="lightbox" role="dialog" aria-modal="true" aria-label="Gallery image" aria-hidden="true">
  <button type="button" class="icon-btn close" aria-label="Close">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <path d="M5 5 19 19M19 5 5 19" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" />
    </svg>
  </button>

  {
    items.length > 1 && (
      <>
        <button type="button" class="icon-btn nav prev" aria-label="Previous image">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path d="M15 5 8 12l7 7" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <button type="button" class="icon-btn nav next" aria-label="Next image">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path d="M9 5 16 12 9 19" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </>
    )
  }

  <div class="stage">
    {
      items.map((item, index) => (
        <figure class="slide" data-index={index}>
          <MediaFrame src={item.src} alt={item.alt} ratio={item.ratio} path={item.path} tone={item.tone} />
        </figure>
      ))
    }
  </div>
</div>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 150;
    display: none;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.92);
  }

  .lightbox.open {
    display: flex;
  }

  .icon-btn {
    position: absolute;
    /* `.stage` is `position: relative` and comes later in the DOM, so
       without an explicit stack order it paints over these — same
       positioned-stacking-context rule that makes DOM order, not visual
       position, decide who's on top. */
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    color: #fff;
    background: none;
    border: 0;
    cursor: pointer;
    opacity: 0.75;
    transition: opacity 0.15s;
  }

  .icon-btn:hover,
  .icon-btn:focus-visible {
    opacity: 1;
  }

  .close {
    top: max(1rem, env(safe-area-inset-top));
    right: max(1rem, env(safe-area-inset-right));
  }

  .nav {
    top: 50%;
    transform: translateY(-50%);
  }

  .prev {
    left: max(0.5rem, env(safe-area-inset-left));
  }

  .next {
    right: max(0.5rem, env(safe-area-inset-right));
  }

  .stage {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    padding: clamp(3rem, 8vw, 5rem);
  }

  .slide {
    position: absolute;
    display: none;
    margin: 0;
    max-width: 100%;
    max-height: 100%;
  }

  .slide.active {
    display: block;
  }

  .slide :global(img),
  .slide :global(.placeholder) {
    width: auto;
    height: min(80vh, 92vw);
    max-width: 92vw;
  }
</style>

<script>
  import { animate } from 'animejs/animation';

  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const lightbox = document.querySelector<HTMLElement>('.lightbox');
  const triggers = [...document.querySelectorAll<HTMLButtonElement>('[data-lightbox-index]')];
  const slides = [...document.querySelectorAll<HTMLElement>('.lightbox .slide')];
  const closeBtn = document.querySelector<HTMLButtonElement>('.lightbox .close');
  const prevBtn = document.querySelector<HTMLButtonElement>('.lightbox .prev');
  const nextBtn = document.querySelector<HTMLButtonElement>('.lightbox .next');

  if (lightbox && triggers.length && slides.length) {
    let activeIndex = 0;
    let lastTrigger: HTMLElement | null = null;

    const activeMedia = () => slides[activeIndex]?.querySelector<HTMLElement>('img, .placeholder') ?? null;

    // FLIP-style: read the trigger's on-screen rect, read the slide's own
    // (already laid out) rect, and animate the gap away — the slide never
    // moves in the DOM, only its transform does.
    const flipFrom = (rect: DOMRect, media: HTMLElement) => {
      const to = media.getBoundingClientRect();
      return {
        x: rect.left + rect.width / 2 - (to.left + to.width / 2),
        y: rect.top + rect.height / 2 - (to.top + to.height / 2),
        scaleX: rect.width / to.width,
        scaleY: rect.height / to.height,
      };
    };

    const showSlide = (index: number, direction: 1 | -1) => {
      const next = slides[index];
      const current = slides[activeIndex];
      if (!next || next === current) return;

      current?.classList.remove('active');
      next.classList.add('active');
      activeIndex = index;

      if (!reduceMotion) {
        const media = next.querySelector<HTMLElement>('img, .placeholder');
        if (media) {
          animate(media, {
            opacity: [0, 1],
            translateX: [28 * direction, 0],
            duration: 380,
            ease: 'outExpo',
          });
        }
      }
    };

    const open = (index: number, trigger: HTMLButtonElement) => {
      lastTrigger = trigger;
      slides.forEach((slide, i) => slide.classList.toggle('active', i === index));
      activeIndex = index;

      lightbox.classList.add('open');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      closeBtn?.focus();

      if (!reduceMotion) {
        const media = activeMedia();
        if (media) {
          const { x, y, scaleX, scaleY } = flipFrom(trigger.getBoundingClientRect(), media);
          animate(media, {
            translateX: [x, 0],
            translateY: [y, 0],
            scaleX: [scaleX, 1],
            scaleY: [scaleY, 1],
            duration: 480,
            ease: 'outExpo',
          });
        }
        animate(lightbox, { opacity: [0, 1], duration: 260, ease: 'outQuad' });
      }
    };

    const close = () => {
      const finish = () => {
        lightbox.classList.remove('open');
        lightbox.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        lastTrigger?.focus();
      };

      const media = activeMedia();

      if (reduceMotion || !lastTrigger || !media) {
        finish();
        return;
      }

      const { x, y, scaleX, scaleY } = flipFrom(lastTrigger.getBoundingClientRect(), media);
      animate(media, { translateX: x, translateY: y, scaleX, scaleY, duration: 360, ease: 'inExpo' });
      animate(lightbox, { opacity: [1, 0], duration: 260, ease: 'inQuad', onComplete: finish });
    };

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => open(Number(trigger.dataset.lightboxIndex), trigger));
    });

    closeBtn?.addEventListener('click', close);
    lightbox.addEventListener('click', (event) => {
      if (event.target === lightbox) close();
    });

    prevBtn?.addEventListener('click', () => showSlide((activeIndex - 1 + slides.length) % slides.length, -1));
    nextBtn?.addEventListener('click', () => showSlide((activeIndex + 1) % slides.length, 1));

    document.addEventListener('keydown', (event) => {
      if (!lightbox.classList.contains('open')) return;
      if (event.key === 'Escape') close();
      if (event.key === 'ArrowLeft') showSlide((activeIndex - 1 + slides.length) % slides.length, -1);
      if (event.key === 'ArrowRight') showSlide((activeIndex + 1) % slides.length, 1);
    });
  }
</script>
