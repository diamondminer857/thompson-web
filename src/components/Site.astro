---
import Intro from './Intro.astro';
import Cursor from './Cursor.astro';
import Marquee from './Marquee.astro';
import Nav from './Nav.astro';
import Hero from './sections/Hero.astro';
import Shows from './sections/Shows.astro';
import Band from './sections/Band.astro';
import Haven from './sections/Haven.astro';
import About from './sections/About.astro';
import Gallery from './sections/Gallery.astro';
import Press from './sections/Press.astro';
import Booking from './sections/Booking.astro';
import Footer from './sections/Footer.astro';

interface Props {
  /** Poster-variant override — see `Hero`. */
  headline?: string;
}
const { headline } = Astro.props;
---

<Intro />
<Cursor />
<Nav />

<main>
  <Hero headline={headline} />
  <Marquee />
  <Shows />
  <Band />
  <Haven />
  <About />
  <Gallery />
  <Press />
  <Booking />
</main>

<Footer />

<script>
  import '../scripts/motion.ts';
</script>
