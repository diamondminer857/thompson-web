---
import MediaFrame from '../MediaFrame.astro';
import GalleryLightbox from '../GalleryLightbox.astro';
import { gallery } from '../../site';

// The wheel wants more photos on it than the shoot has produced so far —
// repeat the source list round-robin up to TARGET_COUNT rather than leaving
// the carousel sparse. Each `gallery` entry already carries its own `path`
// and `tone` (see site.ts), so a repeat's placeholder correctly tells you
// which real file fills every copy of that slot, and a repeated tone still
// reads as a varied wheel rather than one box copy-pasted.
const TARGET_COUNT = 8;
const count = Math.max(gallery.length, TARGET_COUNT);
const items = Array.from({ length: gallery.length ? count : 0 }, (_, index) => gallery[index % gallery.length]);

// Where the fan's spine sits. An even item count can't land exactly on one
// tile from both sides — floor() puts it just left of true centre rather
// than picking a fractional "no tile is actually in the middle" spot, which
// matters here because the point of the layout is that one photo reads as
// the centrepiece.
const center = Math.floor((items.length - 1) / 2);

// A real 360° wheel, not a linear fan: every tile sits at an even angle
// around a full circle, and only the tiles near the top (within
// POINTER_LIMIT of dead centre) are visible/reachable at rest — the rest of
// the wheel is there, just rotated out of view below, exactly like the top
// arc of a Ferris wheel. `sin`/`oneMinusCos` are each tile's resting
// position on that circle, precomputed here because they're the one thing
// the client script and this resting-state markup both need identically —
// see `--sin`/`--one-minus-cos` below and `paint()` in the script, which
// overwrite the same custom properties once the wheel starts turning.
const step = items.length ? 360 / items.length : 0;
const POINTER_LIMIT = 60;
const FADE_LIMIT = 64;
const LEAN_FACTOR = 0.22;

const tiles = items.map((item, index) => {
  const offset = index - center;
  const angle = offset * step;
  const rad = (angle * Math.PI) / 180;
  const absAngle = Math.abs(angle);
  return {
    item,
    index,
    offset,
    sin: Math.sin(rad),
    oneMinusCos: 1 - Math.cos(rad),
    lean: angle * LEAN_FACTOR,
    absAngle,
    hidden: absAngle > POINTER_LIMIT,
  };
});
---

{
  items.length > 0 && (
    <section class="block" id="gallery">
      <p class="label reveal">Gallery</p>

      <div class="carousel full" style={`--step: ${step}deg;`}>
        {tiles.map(({ item, index, offset, sin, oneMinusCos, lean, absAngle, hidden }) => (
          <button
            type="button"
            class="tile reveal"
            style={`--sin: ${sin}; --one-minus-cos: ${oneMinusCos}; --lean: ${lean}; --abs-angle: ${absAngle};`}
            data-lightbox-index={index}
            data-offset={offset}
            aria-hidden={hidden ? 'true' : undefined}
            tabindex={hidden ? -1 : undefined}
            aria-label={`Open ${item.alt}`}
          >
            <MediaFrame src={item.src} alt={item.alt} ratio={item.ratio} path={item.path} tone={item.tone} />
          </button>
        ))}

        {tiles.length > 1 && (
          <div class="wheel-nav">
            <button type="button" class="step-btn prev" aria-label="Rotate gallery left">
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                <path
                  d="M15 5 8 12l7 7"
                  stroke="currentColor"
                  stroke-width="2"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>
            <button type="button" class="step-btn next" aria-label="Rotate gallery right">
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                <path
                  d="M9 5 16 12 9 19"
                  stroke="currentColor"
                  stroke-width="2"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>
          </div>
        )}
      </div>

      <GalleryLightbox items={items} />
    </section>
  )
}

<style define:vars={{ fadeLimit: FADE_LIMIT }}>
  .label {
    --label-accent: var(--accent-cyan);
  }

  /*
   * `.tile` never gets a JS-driven inline `transform` from anime.js — the
   * entrance in motion.ts only animates this group's `opacity` (see
   * `RECIPES.gallery`), on purpose, so it can blend with whatever this file
   * sets on `transform`. That transform, though, *is* driven live by this
   * component's own client script below: `--sin`/`--one-minus-cos` place a
   * tile on the wheel's circle, `--lean` tilts it like it's resting on the
   * rim, `--abs-angle` (distance from dead centre, in degrees) drives its
   * fade/shrink/stacking. The script overwrites all four every frame once
   * the wheel is turning; the inline values above are just its first frame,
   * computed at build time so the page never flashes an unstyled wheel
   * before JS attaches.
   */
  .carousel {
    /* Wider now that the wheel spans the full-bleed track instead of a
       34rem column — radius, height and the tile's `top` all move together:
       a tile's vertical drop off the pivot is radius * (1 - cos θ), so at
       the ±60° POINTER_LIMIT a 21rem radius pushes edge tiles ~10.5rem below
       it, which is what the taller height and higher pivot below account for. */
    --radius: clamp(9rem, 27vw, 21rem);
    position: relative;
    height: clamp(17rem, 44vw, 32rem);
    /* The wheel is a full circle; most of it is meant to sit out of view
       (faded to opacity 0 well before this edge — see --abs-angle below),
       so clipping here just contains that off-screen part instead of
       letting it push the page into horizontal scroll. */
    overflow: hidden;
  }

  .tile {
    position: absolute;
    top: 30%;
    left: 50%;
    width: clamp(6rem, 22vw, 14rem);
    padding: 0;
    font: inherit;
    color: inherit;
    text-align: inherit;
    background: none;
    border: 0;
    cursor: pointer;
    transform-origin: center;
    transform: translate(-50%, -50%)
      translate(calc(var(--radius) * var(--sin)), calc(var(--radius) * var(--one-minus-cos)))
      rotate(calc(var(--lean) * 1deg)) scale(calc(1 - min(var(--abs-angle), 90) / 90 * 0.45));
    z-index: calc(100 - min(var(--abs-angle), 99));
    opacity: calc(1 - min(var(--abs-angle), var(--fadeLimit)) / var(--fadeLimit));
  }

  .tile.is-hidden {
    pointer-events: none;
  }

  /* The dimming lives on the image, not the button: the button's own
     opacity is what motion.ts's entrance reveal animates, and this file's
     live wheel-angle opacity above would otherwise fight it for the exact
     same property on the exact same element. */
  .tile :global(img),
  .tile :global(.placeholder) {
    opacity: calc(1 - min(var(--abs-angle), 40) / 40 * 0.25);
  }

  .wheel-nav {
    position: absolute;
    left: 50%;
    bottom: 0;
    display: flex;
    gap: 0.6rem;
    transform: translateX(-50%);
    z-index: 101;
  }

  .step-btn {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    color: currentColor;
    background: color-mix(in srgb, currentColor 8%, transparent);
    border: 1px solid color-mix(in srgb, currentColor 18%, transparent);
    border-radius: 50%;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 0.2s, background 0.2s;
  }

  .step-btn:hover,
  .step-btn:focus-visible {
    opacity: 1;
    background: color-mix(in srgb, currentColor 14%, transparent);
  }

  /* Same duotone as the hero's aura and rule, applied to the one control
     that's directional by nature: left borrows the cool tint, right the
     warm one. */
  .step-btn.prev:hover,
  .step-btn.prev:focus-visible {
    color: var(--accent-cyan-ink);
    border-color: color-mix(in srgb, var(--accent-cyan) 55%, transparent);
  }

  .step-btn.next:hover,
  .step-btn.next:focus-visible {
    color: var(--accent-magenta-ink);
    border-color: color-mix(in srgb, var(--accent-magenta) 55%, transparent);
  }
</style>

<script>
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const carousel = document.querySelector<HTMLElement>('#gallery .carousel');
  const tiles = [...document.querySelectorAll<HTMLButtonElement>('#gallery .tile')];
  const prevBtn = carousel?.querySelector<HTMLButtonElement>('.step-btn.prev');
  const nextBtn = carousel?.querySelector<HTMLButtonElement>('.step-btn.next');

  if (carousel && tiles.length > 1) {
    const offsets = tiles.map((tile) => Number(tile.dataset.offset));
    const step = 360 / tiles.length;
    const POINTER_LIMIT = 60;
    const IDLE_SPEED = 6; // deg/sec — a slow, ambient drift, not a spin.
    const EASE_RATE = 8;

    const normalize = (angle: number) => {
      let a = angle % 360;
      if (a > 180) a -= 360;
      if (a < -180) a += 360;
      return a;
    };
    const shortestDelta = (from: number, to: number) => normalize(to - from);

    let spin = 0;
    let heldOffset: number | null = null;
    let pendingNudge: number | null = null;

    const paint = () => {
      tiles.forEach((tile, i) => {
        const angle = normalize(offsets[i] * step + spin);
        const rad = (angle * Math.PI) / 180;
        const absAngle = Math.abs(angle);

        tile.style.setProperty('--sin', String(Math.sin(rad)));
        tile.style.setProperty('--one-minus-cos', String(1 - Math.cos(rad)));
        tile.style.setProperty('--lean', String(angle * 0.22));
        tile.style.setProperty('--abs-angle', String(absAngle));

        const hidden = absAngle > POINTER_LIMIT;
        tile.classList.toggle('is-hidden', hidden);
        if (hidden) {
          tile.setAttribute('aria-hidden', 'true');
          tile.setAttribute('tabindex', '-1');
        } else {
          tile.removeAttribute('aria-hidden');
          tile.removeAttribute('tabindex');
        }
      });
    };

    // Reduced motion: every interaction still works, it just jumps straight
    // to the result instead of easing/drifting there — same "off, not
    // reduced" policy as the rest of this file's animation (see motion.ts).
    if (reduceMotion) {
      const centerInstant = (offset: number) => {
        spin += shortestDelta(normalize(offset * step + spin), 0);
        paint();
      };
      tiles.forEach((tile, i) => {
        tile.addEventListener('click', () => centerInstant(offsets[i]));
      });
      prevBtn?.addEventListener('click', () => {
        spin -= step;
        paint();
      });
      nextBtn?.addEventListener('click', () => {
        spin += step;
        paint();
      });
      paint();
    } else {
      let last = performance.now();
      let rafId: number | null = null;

      const loop = (now: number) => {
        const dt = Math.min(0.05, (now - last) / 1000);
        last = now;

        if (heldOffset !== null) {
          const delta = shortestDelta(normalize(heldOffset * step + spin), 0);
          spin += delta * Math.min(1, dt * EASE_RATE);
        } else if (pendingNudge !== null) {
          const delta = pendingNudge - spin;
          spin += delta * Math.min(1, dt * EASE_RATE);
          if (Math.abs(delta) < 0.05) {
            spin = pendingNudge;
            pendingNudge = null;
          }
        } else {
          spin += IDLE_SPEED * dt;
        }

        paint();
        rafId = requestAnimationFrame(loop);
      };

      const start = () => {
        if (rafId === null) {
          last = performance.now();
          rafId = requestAnimationFrame(loop);
        }
      };
      const stop = () => {
        if (rafId !== null) {
          cancelAnimationFrame(rafId);
          rafId = null;
        }
      };

      // Hover targeting runs off real cursor movement, not per-tile
      // mouseenter/mouseleave: every tile on a crowded wheel is animating
      // toward or away from centre, and a moving tile sliding under (or
      // over) a *stationary* cursor still fires enter/leave on itself and
      // its neighbours — cancelling its own hold, or letting a neighbour it
      // swept past steal it mid-flight. `elementFromPoint` on an actual
      // `mousemove` only ever asks "what's under the cursor right now,
      // because the cursor moved" — animation alone can't trigger it.
      carousel.addEventListener('mousemove', (event) => {
        const tile = (document.elementFromPoint(event.clientX, event.clientY) as HTMLElement | null)?.closest<HTMLButtonElement>(
          '.tile',
        );
        const i = tile ? tiles.indexOf(tile) : -1;
        if (i !== -1 && !tile!.classList.contains('is-hidden')) heldOffset = offsets[i];
      });
      carousel.addEventListener('mouseleave', () => {
        heldOffset = null;
      });
      tiles.forEach((tile, i) => {
        tile.addEventListener('focus', () => {
          heldOffset = offsets[i];
        });
        tile.addEventListener('blur', () => {
          heldOffset = null;
        });
      });

      prevBtn?.addEventListener('click', () => {
        heldOffset = null;
        pendingNudge = spin - step;
      });
      nextBtn?.addEventListener('click', () => {
        heldOffset = null;
        pendingNudge = spin + step;
      });

      paint();

      const io = new IntersectionObserver(
        ([entry]) => (entry.isIntersecting ? start() : stop()),
        { threshold: 0.1 },
      );
      io.observe(carousel);
    }
  }
</script>
