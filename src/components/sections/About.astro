---
import MediaFrame from '../MediaFrame.astro';
import { bio, portrait, portraitAlt, site } from '../../site';
---

<section class="block about" id="about">
  <p class="label reveal">About</p>

  <div class="wide layout">
    <div class="copy reveal">
      <p class="lede">{bio.short}</p>
      <p class="long">{bio.long}</p>
      <p class="who">{site.realName} • {site.base}</p>
    </div>

    <!-- A wrapper rather than a class passed into MediaFrame: Astro scopes
         a component's <style> to elements authored in that same file, so a
         `.portrait` rule here would never reach the <img>/<Placeholder> that
         MediaFrame itself renders. -->
    <div class="portrait reveal">
      <MediaFrame {...portrait} />
      <div class="portrait-alt"><MediaFrame {...portraitAlt} /></div>
    </div>
  </div>
</section>

<style>
  .label {
    --label-accent: var(--accent-violet);
  }

  .layout {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
  }

  .portrait {
    position: relative;
    isolation: isolate;
    max-width: 20rem;
  }

  /* A flyer-style offset colour block peeking out behind the photo —
     the one deliberately "poster" flourish on the page, matching the
     technical/rave-poster pairing the type already leans into. */
  .portrait::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    transform: translate(0.85rem, 0.85rem);
    background: linear-gradient(135deg, var(--accent-violet), var(--accent-magenta));
  }

  /* A second, smaller frame — sits inline below the main portrait until
     there's room to overlap it (see the breakpoint below), so it never
     collides with the stacked bio copy on a narrow screen. */
  .portrait-alt {
    width: 8rem;
    margin-top: 0.85rem;
    margin-left: auto;
  }

  .lede {
    margin: 0 0 1.25rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-lede);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--ink-1);
    text-wrap: balance;
  }

  .long {
    margin: 0;
    max-width: 42ch;
    line-height: 1.65;
  }

  .who {
    margin: 1.25rem 0 0;
    font-size: var(--text-meta);
    color: var(--ink-3);
  }

  @media (min-width: 40rem) {
    .layout {
      /* The rest of the page reads left-image/right-text; mirroring this
         one section — portrait on the right — is a deliberate break in
         that pattern. */
      grid-template-columns: 1fr 16rem;
      align-items: start;
    }

    .portrait {
      order: 2;
      max-width: none;
    }

    /* Now that the portrait has room, let the second frame overlap its top
       corner — a contact-sheet pair rather than one lonely box. Top corner,
       not bottom: MediaFrame's placeholder caption sits flush against the
       bottom edge, and a bottom overlap would clip straight through it. */
    .portrait-alt {
      position: absolute;
      z-index: 1;
      top: -2.25rem;
      left: -2.5rem;
      margin: 0;
      box-shadow: 0 0 0 4px var(--paper);
    }
  }
</style>
