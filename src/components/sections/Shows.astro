---
import EventRow from '../EventRow.astro';
import MediaFrame from '../MediaFrame.astro';
import { events } from '../../site';
import { getLangFromUrl, useTranslations, withLang } from '../../i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Same rule as the hero ticker and /event.ics: a show that has already ended
// drops off the page on the next build rather than needing to be remembered.
const upcoming = events
  .filter((event) => new Date(event.end) > new Date())
  .sort((a, b) => Date.parse(a.start) - Date.parse(b.start));

const [featured, ...rest] = upcoming;

// Past this many, the homepage becomes a wall of rows rather than a
// highlight — the overflow lives on /shows instead.
const CAP = 5;
const shown = rest.slice(0, CAP);
const overflow = rest.length - shown.length;
---

{
  /* Always rendered, even with nothing booked — the nav's `#shows` anchor
     and scrollspy (`main > section[id]`) both depend on this section
     existing, not just on there being something to show inside it. */
  <section class="block" id="shows">
    <p class="label reveal">{t('shows.label')}</p>

    {featured ? (
      <>
        <div class="wide feature">
          <div class="detail">
            <EventRow event={featured} featured />
          </div>

          {featured.poster && (
            <div class="flyer reveal">
              <MediaFrame {...featured.poster} />
            </div>
          )}
        </div>

        {shown.length > 0 && (
          <div class="wide rest">
            {shown.map((event) => (
              <EventRow event={event} />
            ))}
          </div>
        )}

        {overflow > 0 && (
          <p class="wide more reveal">
            <a class="btn btn-ghost" href={withLang('/shows', lang)}>
              <span>{t('shows.allShows', { count: upcoming.length })}</span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </p>
        )}
      </>
    ) : (
      <p class="empty reveal">{t('shows.empty')}</p>
    )}
  </section>
}

<style>
  .label {
    --label-accent: var(--accent-cyan);
  }

  .feature {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .empty {
    color: var(--ink-3);
  }

  .rest {
    margin-top: 1.75rem;
  }

  .more {
    margin: 1.75rem 0 0;
  }

  /* A secondary "see more" action, not a full-width primary CTA — `.btn`
     defaults to `display: flex; width: 100%`, and a block-level flex box
     with `width: auto` still fills its container (auto ≠ shrink-to-fit for
     block boxes), so this needs `inline-flex` too, not just the width
     override, to actually hug its content. */
  .more .btn {
    display: inline-flex;
    width: auto;
    padding-inline: 2rem;
  }

  .more .arrow {
    display: inline-block;
    transform: translateX(0);
  }

  /* The same offset accent block About's portrait uses — one flyer
     language reused instead of a second graphic idiom. */
  .flyer {
    position: relative;
    isolation: isolate;
    max-width: 16rem;
  }

  .flyer::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    transform: translate(0.9rem, 0.9rem);
    background: linear-gradient(135deg, var(--accent-cyan), var(--accent-violet));
  }

  @media (min-width: 60rem) {
    .feature:has(.flyer) {
      grid-template-columns: 1fr 15rem;
      align-items: end;
    }

    .flyer {
      max-width: none;
    }
  }
</style>
