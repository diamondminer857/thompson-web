---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { site } from '../site';

interface Props {
  title?: string;
  description?: string;
  /** Poster-variant pages are the same content on another URL — keep them out of search. */
  noindex?: boolean;
}

const {
  title = `${site.name} — ${site.strapline}`,
  description = `${site.strapline}. Haven — a monthly mix series. Bookings open.`,
  noindex = false,
} = Astro.props;

const canonical = new URL('/', Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;

// Set PUBLIC_CF_BEACON_TOKEN once Cloudflare Web Analytics is created; until
// then the beacon simply isn't emitted.
const beacon = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0a0a0a" />

    <script is:inline>
      /* Dark is the identity now, not the toggle's target — see README
         "Design notes". `prefers-color-scheme` is still never consulted; the
         only way to the white poster page is this explicit choice, stored
         here and re-applied before paint so a returning visitor never sees
         a flash. Visitors carrying an old 'dark' value from before the flip
         land on the new default, which is exactly what they had. */
      try {
        if (localStorage.getItem('theme') === 'light') {
          document.documentElement.dataset.theme = 'light';
          document.querySelector('meta[name="theme-color"]').content = '#ffffff';
        }
      } catch {}
    </script>

    <script is:inline>
      /* First screen of a browser session gets a branded intro beat (see
         `Intro.astro` / `motion.ts`'s `playIntro`) — a poster scan following a
         fresh tab. Repeat views in the same tab (scrolling back to `/`, a
         poster-variant page loaded right after) don't replay it. Set before
         paint so the overlay is the first frame rather than flashing in after
         the hero has already appeared underneath it. */
      try {
        if (!sessionStorage.getItem('introSeen')) {
          document.documentElement.dataset.intro = 'pending';
        }
      } catch {}
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />

    {beacon && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: beacon })}
      />
    )}
  </head>

  <body>
    <slot />
  </body>
</html>
