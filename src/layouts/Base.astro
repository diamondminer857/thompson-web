---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { site } from '../site';
import { getLangFromUrl, useTranslations, withLang } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  /** Poster-variant pages are the same content on another URL — keep them out of search. */
  noindex?: boolean;
  /**
   * The language-neutral path this page lives at (e.g. `/` or `/shows`) —
   * pass it to get reciprocal `hreflang` alternates. Omit on pages with no
   * counterpart in the other language (poster variants, 404).
   */
  hrefLangPath?: string;
  /**
   * Override for the canonical URL's path. Poster-variant pages are
   * near-duplicate content on their own URL and deliberately canonicalize to
   * `/` instead of themselves (paired with `noindex` above); every other
   * page wants its own actual path, which is the default.
   */
  canonicalPath?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  title = `${site.name} | ${site.strapline}`,
  description = `${site.strapline}. ${t('meta.description')}`,
  noindex = false,
  hrefLangPath,
  canonicalPath = Astro.url.pathname,
} = Astro.props;

const canonical = new URL(canonicalPath, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
const ogLocale = lang === 'cs' ? 'cs_CZ' : 'en_GB';

// Set PUBLIC_CF_BEACON_TOKEN once Cloudflare Web Analytics is created; until
// then the beacon simply isn't emitted.
const beacon = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    {hrefLangPath && (
      <>
        <link rel="alternate" hreflang="en" href={new URL(withLang(hrefLangPath, 'en'), Astro.site).href} />
        <link rel="alternate" hreflang="cs" href={new URL(withLang(hrefLangPath, 'cs'), Astro.site).href} />
        <link rel="alternate" hreflang="x-default" href={new URL(withLang(hrefLangPath, 'en'), Astro.site).href} />
      </>
    )}

    <!-- ICO first: Safari ignores SVG favicons and falls back to it, so it
         has to be declared, and has to match the SVG rather than invert it. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0a0a0a" />

    <script is:inline>
      /* Dark is the identity now, not the toggle's target — see README
         "Design notes". `prefers-color-scheme` is still never consulted; the
         only way to the white poster page is this explicit choice, stored
         here and re-applied before paint so a returning visitor never sees
         a flash. Visitors carrying an old 'dark' value from before the flip
         land on the new default, which is exactly what they had. */
      try {
        if (localStorage.getItem('theme') === 'light') {
          document.documentElement.dataset.theme = 'light';
          document.querySelector('meta[name="theme-color"]').content = '#ffffff';
        }
      } catch {}
    </script>

    <script is:inline>
      /* First screen of a browser session gets a branded intro beat (see
         `Intro.astro` / `motion.ts`'s `playIntro`) — a poster scan following a
         fresh tab. Repeat views in the same tab (scrolling back to `/`, a
         poster-variant page loaded right after) don't replay it. Set before
         paint so the overlay is the first frame rather than flashing in after
         the hero has already appeared underneath it. */
      try {
        if (!sessionStorage.getItem('introSeen')) {
          document.documentElement.dataset.intro = 'pending';
        }
      } catch {}
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />

    {beacon && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: beacon })}
      />
    )}
  </head>

  <body>
    <slot />
  </body>
</html>
